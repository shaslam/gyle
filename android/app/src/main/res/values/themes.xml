<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The page draws everything. The theme only sets what shows before the page loads,
         and the colours of the bars at the top and bottom of the screen. -->
    <style name="Gyle" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/wall</item>
        <item name="android:statusBarColor">@color/green</item>
        <item name="android:navigationBarColor">@color/wall</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:alertDialogTheme">@style/Gyle.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Gyle.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/Gyle.Dialog</item>
    </style>

    <!-- Android's own dialogs (the date picker): a cream panel with round corners as in the page,
         and Gyle's green for the heading, the selected day and the buttons. The two widths let the
         dialog be as narrow as its content, so the green heading reaches both edges. -->
    <style name="Gyle.Dialog" parent="android:Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/green</item>
        <item name="android:windowBackground">@drawable/dialog_panel</item>
        <item name="android:windowClipToOutline">true</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>
</resources>
